@model OpsPilot.Models.ServiceRequest

@{
    ViewData["Title"] = "Service Request Details";
}

<div class="mt-4">
    <h1>Service Request Details</h1>
    <p class="text-muted">View the information for this request.</p>

    <div class="card mt-4">
        <div class="card-body">
            <h4 class="card-title">@Model.Title</h4>

            <dl class="row mt-4">
                <dt class="col-sm-3">Request ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@Model.Customer?.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">@Model.Priority</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")
                </dd>
            </dl>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Back to Requests
    </a>
</div>
