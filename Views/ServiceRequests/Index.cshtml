@model IEnumerable<OpsPilot.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";

    string currentStatus = ViewBag.Status as string ?? "";
    string currentPriority = ViewBag.Priority as string ?? "";
}

<div class="mt-4">
    <h1>Service Requests</h1>

    <p class="text-muted">
        View and track customer service requests.
    </p>

    <a asp-action="Create" class="btn btn-primary mb-4">
        Add Service Request
    </a>

    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search requests or customers" />
        </div>

        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>

                @foreach (var status in new[] { "Open", "In Progress", "Completed" })
                {
                    if (currentStatus == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="">All Priorities</option>

                @foreach (var priority in new[] { "Low", "Normal", "High" })
                {
                    if (currentPriority == priority)
                    {
                        <option value="@priority" selected>@priority</option>
                    }
                    else
                    {
                        <option value="@priority">@priority</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No service requests found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover management-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Customer</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.Title</td>

                            <td>@request.Customer?.Name</td>

                            <td>
                                @if (request.Priority == "High")
                                {
                                    <span class="badge bg-danger">High</span>
                                }
                                else if (request.Priority == "Normal")
                                {
                                    <span class="badge bg-primary">Normal</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Low</span>
                                }
                            </td>

                            <td>
                                @if (request.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (request.Status == "In Progress")
                                {
                                    <span class="badge bg-warning text-dark">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Open</span>
                                }
                            </td>

                            <td>
                                @request.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
