@model IEnumerable<SiteActionLedger.Models.ServiceRequest>

@{
    ViewData["Title"] = "Site Issues";

    string currentStatus = ViewBag.Status as string ?? "";
    string currentPriority = ViewBag.Priority as string ?? "";
    string currentCategory = ViewBag.Category as string ?? "";
}

<div class="mt-4">
    <h1>Site Issues</h1>

    <p class="text-muted">
        Track construction issues by project, category, and location.
    </p>

    <a asp-action="Create" class="btn btn-primary mb-4">
        Report Site Issue
    </a>

    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search issues, projects, clients, or locations" />
        </div>

        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>

                @foreach (var status in new[]
                {
                    SiteIssueStatuses.Open,
                    SiteIssueStatuses.InProgress,
                    SiteIssueStatuses.Completed
                })
                {
                    if (currentStatus == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="">All Priorities</option>

                @foreach (var priority in new[] { "Low", "Normal", "High" })
                {
                    if (currentPriority == priority)
                    {
                        <option value="@priority" selected>@priority</option>
                    }
                    else
                    {
                        <option value="@priority">@priority</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="category" class="form-select">
                <option value="">All Categories</option>

                @foreach (var category in new[]
                {
                    "Electrical",
                    "Plumbing",
                    "HVAC",
                    "Structural",
                    "Interior Finishes",
                    "Safety",
                    "Other"
                })
                {
                    if (currentCategory == category)
                    {
                        <option value="@category" selected>@category</option>
                    }
                    else
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No site issues found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover management-table">
                <thead>
                    <tr>
                        <th>Issue</th>
                        <th>Project</th>
                        <th>Client</th>
                        <th>Category</th>
                        <th>Site Location</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.Title</td>

                            <td>
                                @if (request.Project != null)
                                {
                                    <a asp-controller="Projects"
                                       asp-action="Details"
                                       asp-route-id="@request.ProjectId">
                                        @request.Project.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not Assigned
                                    </span>
                                }
                            </td>

                            <td>@request.Customer?.Name</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(request.Category)
                                    ? "Not Specified"
                                    : request.Category)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(request.SiteArea)
                                    ? "Not Specified"
                                    : request.SiteArea)
                            </td>

                            <td>
                                @if (request.Priority == "High")
                                {
                                    <span class="badge bg-danger">
                                        High
                                    </span>
                                }
                                else if (request.Priority == "Normal")
                                {
                                    <span class="badge bg-primary">
                                        Normal
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Low
                                    </span>
                                }
                            </td>

                            <td>
                                @if (request.Status == SiteIssueStatuses.Completed)
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else if (request.Status == SiteIssueStatuses.InProgress)
                                {
                                    <span class="badge bg-warning text-dark">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Open
                                    </span>
                                }
                            </td>

                            <td>
                                @request.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>