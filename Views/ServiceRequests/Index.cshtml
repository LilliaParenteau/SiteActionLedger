@model List<OpsPilot.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="mt-4">
    <h1>Service Requests</h1>
    <p class="text-muted">
        View and track customer service requests.
    </p>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Add Service Request
    </a>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info mt-4">
            No service requests have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped mt-4">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Customer</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.Title</td>
                            <td>@request.Customer?.Name</td>
                            <td>@request.Priority</td>
                            <td>@request.Status</td>
                            <td>@request.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
