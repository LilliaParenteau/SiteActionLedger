@model OpsPilot.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mt-4">
    <h1>OpsPilot Dashboard</h1>
    <p class="text-muted">
        Overview of customers, service requests, and work orders.
    </p>

    <div class="row mt-4">
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Customers</h6>
                    <h2 class="my-3">@Model.CustomerCount</h2>
                    <a asp-controller="Customers"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Customers
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Open Requests</h6>
                    <h2 class="my-3">@Model.OpenRequestCount</h2>
                    <a asp-controller="ServiceRequests"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Requests
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Active Work Orders</h6>
                    <h2 class="my-3">@Model.ActiveWorkOrderCount</h2>
                    <a asp-controller="WorkOrders"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Work Orders
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Technicians</h6>
                    <h2 class="my-3">@Model.TechnicianCount</h2>
                    <a asp-controller="Technicians"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Technicians
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
