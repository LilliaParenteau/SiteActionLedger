@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h1>OpsPilot Dashboard</h1>
    <p class="text-muted">
        Manage customers, service requests, and work orders.
    </p>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Customers</h5>
                    <p class="card-text">
                        View and manage customer information.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Service Requests</h5>
                    <p class="card-text">
                        Track incoming service requests.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Work Orders</h5>
                    <p class="card-text">
                        Organize and monitor active jobs.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
