@model SiteActionTrace.Models.WorkOrder

@{
    ViewData["Title"] = "Create Work Order";
}

<div class="mt-4">
    <h1>Create Work Order</h1>

    <p class="text-muted">
        Schedule corrective work for a reported site issue.
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="SiteIssueId" class="form-label">
                Site Issue
            </label>

            <select asp-for="SiteIssueId"
                    asp-items="ViewBag.SiteIssues"
                    class="form-select">
                <option value="0">Select a site issue</option>
            </select>

            <span asp-validation-for="SiteIssueId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TechnicianId" class="form-label">
                Assigned Technician
            </label>

            <select asp-for="TechnicianId"
                    asp-items="ViewBag.Technicians"
                    class="form-select">
                <option value="">Unassigned</option>
            </select>

            <span asp-validation-for="TechnicianId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ScheduledDate" class="form-label">
                Scheduled Date
            </label>

            <input asp-for="ScheduledDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="ScheduledDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">
                Work Notes
            </label>

            <textarea asp-for="Notes"
                      class="form-control"
                      rows="4"
                      placeholder="Describe the corrective work required"></textarea>

            <span asp-validation-for="Notes"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create Work Order
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}