@model SiteActionLedger.Models.WorkOrder

@{
    ViewData["Title"] = "Edit Work Order";
}

<div class="mt-4">
    <h1>Edit Work Order #@Model.Id</h1>

    <p class="text-muted">
        Manage corrective work, technician assignments, and resolution details.
    </p>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Associated Site Issue</h5>

            <a asp-controller="ServiceRequests"
               asp-action="Details"
               asp-route-id="@Model.ServiceRequestId">
                @Model.ServiceRequest?.Title
            </a>

            <p class="text-muted mb-0 mt-2">
                Client: @Model.ServiceRequest?.Customer?.Name
            </p>
        </div>
    </div>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="ScheduledDate" class="form-label">
                Scheduled Date
            </label>

            <input asp-for="ScheduledDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="ScheduledDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TechnicianId" class="form-label">
                Assigned Technician
            </label>

            <select asp-for="TechnicianId"
                    asp-items="ViewBag.Technicians"
                    class="form-select">
                <option value="">Unassigned</option>
            </select>

            <span asp-validation-for="TechnicianId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">
                Work Order Status
            </label>

            <select asp-for="Status" class="form-select">
                <option value="@WorkOrderStatuses.Pending">Pending</option>
                <option value="@WorkOrderStatuses.InProgress">In Progress</option>
                <option value="@WorkOrderStatuses.Completed">Completed</option>
            </select>

            <span asp-validation-for="Status"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">
                Work Notes
            </label>

            <textarea asp-for="Notes"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Notes"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ResolutionNotes" class="form-label">
                Resolution Notes
            </label>

            <textarea asp-for="ResolutionNotes"
                      class="form-control"
                      rows="4"
                      placeholder="Describe the corrective work completed"></textarea>

            <span asp-validation-for="ResolutionNotes"
                  class="text-danger"></span>

            <div class="form-text">
                Required when marking the work order Completed.
            </div>
        </div>

        @if (Model.CompletedAt.HasValue)
        {
            <div class="mb-3">
                <label class="form-label">Completion Date</label>

                <p class="form-control-plaintext">
                    @Model.CompletedAt.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                </p>
            </div>
        }

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}