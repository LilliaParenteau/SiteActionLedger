@model OpsPilot.Models.WorkOrder

@{
    ViewData["Title"] = "Work Order Details";
}

<div class="mt-4">
    <h1>Work Order #@Model.Id</h1>
    <p class="text-muted">View work order information.</p>

    <div class="card mt-4">
        <div class="card-body">
            <h4 class="card-title">
                @Model.ServiceRequest?.Title
            </h4>

            <dl class="row mt-4">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">
                    @Model.ServiceRequest?.Customer?.Name
                </dd>

                <dt class="col-sm-3">Service Request</dt>
                <dd class="col-sm-9">
                    #@Model.ServiceRequestId
                </dd>

                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">
                    @(Model.ScheduledDate?.ToString("MM/dd/yyyy")
                        ?? "Not scheduled")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Job Notes</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "No notes added."
                        : Model.Notes)
                </dd>
            </dl>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Back to Work Orders
    </a>
</div>
