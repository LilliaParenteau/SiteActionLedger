@model SiteActionTrace.Models.WorkOrder

@{
    ViewData["Title"] = "Work Order Details";
}

<div class="mt-4">
    <h1>Work Order Details</h1>

    <p class="text-muted">
        Review assigned corrective work and its resolution.
    </p>

    <div class="card mt-4">
        <div class="card-body">
            <h4>Work Order #@Model.Id</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Site Issue</dt>
                <dd class="col-sm-9">
                    <a asp-controller="SiteIssues"
                       asp-action="Details"
                       asp-route-id="@Model.SiteIssueId">
                        @Model.SiteIssue?.Title
                    </a>
                </dd>

                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">
                    @Model.SiteIssue?.Customer?.Name
                </dd>

                <dt class="col-sm-3">Assigned Technician</dt>
                <dd class="col-sm-9">
                    @(Model.Technician?.Name ?? "Unassigned")
                </dd>

                <dt class="col-sm-3">Specialty</dt>
                <dd class="col-sm-9">
                    @(Model.Technician?.Specialty ?? "Not Specified")
                </dd>

                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">
                    @(Model.ScheduledDate?.ToString("MM/dd/yyyy")
                        ?? "Not Scheduled")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == WorkOrderStatuses.Completed)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (Model.Status == WorkOrderStatuses.InProgress)
                    {
                        <span class="badge bg-warning text-dark">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pending</span>
                    }
                </dd>

                <dt class="col-sm-3">Work Notes</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "No notes"
                        : Model.Notes)
                </dd>

                <dt class="col-sm-3">Resolution Notes</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.ResolutionNotes)
                        ? "Not provided"
                        : Model.ResolutionNotes)
                </dd>

                <dt class="col-sm-3">Completion Date</dt>
                <dd class="col-sm-9">
                    @(Model.CompletedAt.HasValue
                        ? Model.CompletedAt.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                        : "Not Completed")
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit Work Order
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Work Orders
        </a>
    </div>
</div>