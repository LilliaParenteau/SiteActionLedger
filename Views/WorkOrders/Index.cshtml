@model IEnumerable<OpsPilot.Models.WorkOrder>

@{
    ViewData["Title"] = "Work Orders";
}

<div class="mt-4">
    <h1>Work Orders</h1>
    <p class="text-muted">
        Manage scheduled work and technician assignments.
    </p>

    <a asp-action="Create" class="btn btn-primary mb-4">
        Add Work Order
    </a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No work orders have been created yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover management-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Service Request</th>
                        <th>Customer</th>
                        <th>Technician</th>
                        <th>Scheduled Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>

                            <td>@order.ServiceRequest?.Title</td>

                            <td>@order.ServiceRequest?.Customer?.Name</td>

                            <td>
                                @if (order.Technician != null)
                                {
                                    @order.Technician.Name
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>

                            <td>
                                @(order.ScheduledDate?.ToString("MM/dd/yyyy") ?? "Not Scheduled")
                            </td>

                            <td>
                                @if (order.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (order.Status == "In Progress")
                                {
                                    <span class="badge bg-primary">In Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
