@model IEnumerable<SiteActionLedger.Models.WorkOrder>

@{
    ViewData["Title"] = "Work Orders";
}

<div class="mt-4">
    <h1>Work Orders</h1>

    <p class="text-muted">
        Manage scheduled work and technician assignments.
    </p>

    <a asp-action="Create" class="btn btn-primary mb-4">
        Add Work Order
    </a>

    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-5">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search site issues, customers, or technicians" />
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>

                @foreach (var status in new[]
                {
                    WorkOrderStatuses.Pending,
                    WorkOrderStatuses.InProgress,
                    WorkOrderStatuses.Completed
                })
                {
                    if (ViewBag.Status == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No work orders found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover management-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Site Issue</th>
                        <th>Customer</th>
                        <th>Technician</th>
                        <th>Scheduled Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>

                            <td>
                                <a asp-controller="SiteIssues"
                                   asp-action="Details"
                                   asp-route-id="@order.SiteIssueId">
                                    @order.SiteIssue?.Title
                                </a>
                            </td>

                            <td>@order.SiteIssue?.Customer?.Name</td>

                            <td>
                                @if (order.Technician != null)
                                {
                                    @order.Technician.Name
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>

                            <td>
                                @(order.ScheduledDate?.ToString("MM/dd/yyyy") ?? "Not Scheduled")
                            </td>

                            <td>
                                @if (order.Status == WorkOrderStatuses.Completed)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (order.Status == WorkOrderStatuses.InProgress)
                                {
                                    <span class="badge bg-primary">In Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>