@model  SiteActionTrace.Models.Technician

@{
    ViewData["Title"] = "Add Technician";
}

<div class="mt-4">
    <h1>Add Technician</h1>
    <p class="text-muted">
        Enter the new technician's information.
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Specialty" class="form-label"></label>
            <input asp-for="Specialty" class="form-control" />
            <span asp-validation-for="Specialty"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Technician
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
