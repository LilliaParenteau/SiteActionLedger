@model SiteActionLedger.Models.SiteIssue

@{
    ViewData["Title"] = "Site Issue Details";
}

<div class="mt-4">
    <h1>Site Issue Details</h1>

    <p class="text-muted">
        View construction issue information and corrective work.
    </p>

    <div class="card mt-4">
        <div class="card-body">
            <h4>@Model.Title</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Construction Project</dt>
                <dd class="col-sm-9">
                    @if (Model.Project != null)
                    {
                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@Model.ProjectId">
                            @Model.Project.Name
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">Not Assigned</span>
                    }
                </dd>

                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">
                    @Model.Customer?.Name
                </dd>

                <dt class="col-sm-3">Issue Description</dt>
                <dd class="col-sm-9">
                    @Model.Description
                </dd>

                <dt class="col-sm-3">Issue Category</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Category)
                        ? "Not Specified"
                        : Model.Category)
                </dd>

                <dt class="col-sm-3">Site Location</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.SiteArea)
                        ? "Not Specified"
                        : Model.SiteArea)
                </dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">
                    @if (Model.Priority == "High")
                    {
                        <span class="badge bg-danger">High</span>
                    }
                    else if (Model.Priority == "Normal")
                    {
                        <span class="badge bg-primary">Normal</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Low</span>
                    }
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == SiteIssueStatuses.Completed)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (Model.Status == SiteIssueStatuses.InProgress)
                    {
                        <span class="badge bg-warning text-dark">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Open</span>
                    }
                </dd>

                <dt class="col-sm-3">Date Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy")
                </dd>
            </dl>

            <hr />

            <h5>Associated Work Order</h5>

            @if (ViewBag.WorkOrderId != null)
            {
                <p class="text-muted">
                    A work order has been created for this issue.
                </p>

                <a asp-controller="WorkOrders"
                   asp-action="Details"
                   asp-route-id="@ViewBag.WorkOrderId"
                   class="btn btn-outline-primary">
                    View Work Order
                </a>
            }
            else
            {
                <p class="text-muted">
                    No work order has been created for this issue.
                </p>

                <a asp-controller="WorkOrders"
                   asp-action="Create"
                   asp-route-siteIssueId="@Model.Id"
                   class="btn btn-outline-primary">
                    Create Work Order
                </a>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit Issue
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Site Issues
        </a>
    </div>
</div>