@model SiteActionLedger.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<div class="mt-4">
    <h1>Edit Construction Project</h1>

    <p class="text-muted">
        Update project and job-site information.
    </p>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Project Name
            </label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerId" class="form-label">
                Client
            </label>

            <select asp-for="CustomerId"
                    asp-items="ViewBag.Customers"
                    class="form-select">
                <option value="0">Select a client</option>
            </select>

            <span asp-validation-for="CustomerId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SiteAddress" class="form-label">
                Job Site Address
            </label>

            <input asp-for="SiteAddress"
                   class="form-control" />

            <span asp-validation-for="SiteAddress"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Project Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">
                Project Status
            </label>

            <select asp-for="Status" class="form-select">
                <option value="@ProjectStatuses.Active">Active</option>
                <option value="@ProjectStatuses.OnHold">On Hold</option>
                <option value="@ProjectStatuses.Completed">Completed</option>
            </select>

            <span asp-validation-for="Status"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}