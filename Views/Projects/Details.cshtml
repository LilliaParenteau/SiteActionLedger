@model SiteActionLedger.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="mt-4">
    <h1>Project Details</h1>
    <p class="text-muted">
        View construction project and job-site information.
    </p>

    <div class="card mt-4">
        <div class="card-body">
            <h4>@Model.Name</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">@Model.Customer?.Name</dd>

                <dt class="col-sm-3">Job Site Address</dt>
                <dd class="col-sm-9">@Model.SiteAddress</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Not provided"
                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (Model.Status == "On Hold")
                    {
                        <span class="badge bg-warning text-dark">On Hold</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">Active</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit Project
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Projects
        </a>
    </div>
</div>
