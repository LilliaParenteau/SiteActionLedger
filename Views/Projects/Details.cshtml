@model SiteActionLedger.Models.Project

@{
    ViewData["Title"] = "Project Details";

    var siteIssues = ViewBag.SiteIssues
        as List<SiteActionLedger.Models.ServiceRequest>
        ?? new List<SiteActionLedger.Models.ServiceRequest>();
}

<div class="mt-4">
    <h1>Project Details</h1>

    <p class="text-muted">
        View project information and reported site issues.
    </p>

    <div class="card mt-4">
        <div class="card-body">
            <h4>@Model.Name</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">@Model.Customer?.Name</dd>

                <dt class="col-sm-3">Job Site Address</dt>
                <dd class="col-sm-9">@Model.SiteAddress</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Not provided"
                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == ProjectStatuses.Completed)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (Model.Status == ProjectStatuses.OnHold)
                    {
                        <span class="badge bg-warning text-dark">On Hold</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">Active</span>
                    }
                </dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                Edit Project
            </a>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    Site Issues (@siteIssues.Count)
                </h5>

                <a asp-controller="ServiceRequests"
                   asp-action="Create"
                   asp-route-projectId="@Model.Id"
                   class="btn btn-primary btn-sm">
                    Report Site Issue
                </a>
            </div>

            @if (!siteIssues.Any())
            {
                <p class="text-muted">
                    No site issues have been reported for this project.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Issue</th>
                                <th>Category</th>
                                <th>Site Location</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var issue in siteIssues)
                            {
                                <tr>
                                    <td>@issue.Title</td>
                                    <td>@(issue.Category ?? "Not Specified")</td>
                                    <td>@(issue.SiteArea ?? "Not Specified")</td>
                                    <td>@issue.Priority</td>

                                    <td>
                                        @if (issue.Status == SiteIssueStatuses.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (issue.Status == SiteIssueStatuses.InProgress)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Open
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="ServiceRequests"
                                           asp-action="Details"
                                           asp-route-id="@issue.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            Back to Projects
        </a>
    </div>
</div>